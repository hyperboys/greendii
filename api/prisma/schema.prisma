  handOverJob   HandOverJob? @relation(fields: [handOverJobId], references: [id])
  sentById      String
  sentBy        User       @relation(fields: [sentById], references: [id])
  toRecipients  Json
  ccRecipients  Json?
  bccRecipients Json?
  subject       String
  bodyHtml      String
  bodyText      String?
  attachments   Json?
  status        String     @default("sent")
  errorMessage  String?
  sentAt        DateTime   @default(now()) @db.Timestamptz(3)
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)

  @@index([workOrderId])
  @@index([quotationId])
  @@index([handOverJobId])
  @@index([sentById])
  @@index([sentAt])
  @@map("email_logs")
}

// ─────────────────────────────────────────────
// ACTIVITY LOG
// ─────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username   String?  // snapshot ชื่อ user ณ เวลานั้น
  method     String   // GET POST PUT PATCH DELETE
  path       String   // /api/quotations/xxx
  statusCode Int      // 200 201 400 401 403 500
