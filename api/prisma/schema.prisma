  address                    String?
  salesId                    String?                   @map("sales_id")
  customerPoNo               String?                   @map("customer_po_no")
  creditTerm                 Int                       @default(30) @map("credit_term")
  dueDate                    DateTime?                 @db.Timestamptz(3)
  workOrderId                String?                   @map("work_order_id")
  workOrder                  WorkOrder?                @relation(fields: [workOrderId], references: [id])
  provisionalDeliveryOrderId String?                   @map("provisional_delivery_order_id")
