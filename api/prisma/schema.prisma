model Invoice {
  id                         String                    @id @default(cuid())
  ivNo                       String                    @unique
  ivDate                     DateTime                  @default(now()) @db.Timestamptz(3)
  customerId                 String?                   @map("customer_id")
  customer                   AccountCustomer?          @relation(fields: [customerId], references: [id])
  customerBranch             String?                   @default("สำนักงานใหญ่") @map("customer_branch")
