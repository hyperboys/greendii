  lineDiscount Decimal         @default(0) @db.Decimal(12, 2) @map("line_discount")
  vat          Decimal         @default(0) @db.Decimal(12, 2)
  amount       Decimal         @default(0) @db.Decimal(12, 2)

  @@map("invoice_lines")
