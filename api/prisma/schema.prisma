}

// ─────────────────────────────────────────────
// DOMAIN AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(cuid())
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  docNo         String?  @map("doc_no")
