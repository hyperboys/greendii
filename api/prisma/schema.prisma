  returnNo     String      @unique
  returnDate   DateTime    @default(now()) @db.Timestamptz(3)
  workOrderId  String?     @map("work_order_id")
  workOrder    WorkOrder?  @relation(fields: [workOrderId], references: [id])
  stockIssueId String?     @map("stock_issue_id")
  stockIssue   StockIssue? @relation(fields: [stockIssueId], references: [id])
  warehouseId  String?     @map("warehouse_id")
  warehouse    Warehouse?  @relation(fields: [warehouseId], references: [id])
  condition    String?     @default("good") // good | damaged
  remark       String?
  status       DocStatus   @default(draft)
  approvalStep Int         @default(0)
  createdById  String?     @map("created_by_id")
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  items StockReturnLine[]

  @@map("stock_returns")
}

model StockReturnLine {
  id            String         @id @default(cuid())
  stockReturnId String         @map("stock_return_id")
  stockReturn   StockReturn    @relation(fields: [stockReturnId], references: [id], onDelete: Cascade)
  seq           Int            @default(0)
  productId     String         @map("product_id")
  product       AccountProduct @relation(fields: [productId], references: [id])
  returnedQty   Decimal        @default(0) @db.Decimal(12, 3) @map("returned_qty")

  @@map("stock_return_lines")
}

model StockMovement {
  id              String         @id @default(cuid())
  movementType    String         @map("movement_type") // in | out | adjust | reversal
  productId       String         @map("product_id")
  product         AccountProduct @relation(fields: [productId], references: [id])
  warehouseId     String         @map("warehouse_id")
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id])
  qtyIn           Decimal        @default(0) @db.Decimal(12, 3) @map("qty_in")
  qtyOut          Decimal        @default(0) @db.Decimal(12, 3) @map("qty_out")
  sourceDocType   String         @map("source_doc_type") // goods_receipt | stock_issue | stock_return
  sourceDocId     String         @map("source_doc_id")
  sourceDocNo     String?        @map("source_doc_no")
  transactionDate DateTime       @default(now()) @map("transaction_date") @db.Timestamptz(3)
  createdById     String?        @map("created_by_id")
  reversalRefId   String?        @map("reversal_ref_id")
  remark          String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  @@index([productId, warehouseId])
  @@index([sourceDocType, sourceDocId])
  @@index([transactionDate])
  @@map("stock_movements")
}
