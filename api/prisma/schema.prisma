  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([createdAt])
  @@index([statusCode])
  @@map("activity_logs")
}

// ─────────────────────────────────────────────
// ATTACHMENT
// ─────────────────────────────────────────────

model Attachment {
